<div class="weapons-tab-content">

    <!-- Combat actions without a weapon (p. 42-43) -->
    <div class="combat-actions-bar">
        <button type="button" data-action="combatDefend" data-tooltip="{{localize 'ABEA.Combat.Hint.Defend'}}">
            <i class="fas fa-shield-halved"></i> {{localize "ABEA.Combat.Action.Defend"}}
        </button>
        <button type="button" data-action="combatDodge" data-tooltip="{{localize 'ABEA.Combat.Hint.Dodge'}}">
            <i class="fas fa-person-running"></i> {{localize "ABEA.Combat.Action.Dodge"}}
        </button>
        <button type="button" data-action="combatAid" data-tooltip="{{localize 'ABEA.Combat.Hint.Aid'}}">
            <i class="fas fa-handshake-angle"></i> {{localize "ABEA.Combat.Action.Aid"}}
        </button>
    </div>

    <!-- Headers Grid -->
    <div class="weapons-header-row">
        <div class="weapon-header-line-left"></div>
        <div class="weapon-damage-header">
            <span>{{localize "ABEA.Item.Damage"}}</span>
        </div>
        <div class="weapon-header-line-right"></div>
    </div>

    <!-- Weapons List Grid -->
    <div class="weapons-list-grid">
        {{#each weapons as |item|}}
        <div class="weapon-row-grid item draggable" data-item-id="{{item.id}}" data-tooltip="{{abeaItemTooltip item}}"
            draggable="true">
            <!-- Image -->
            <div class="weapon-image">
                <img src="{{item.img}}" title="{{item.name}}" />
            </div>

            <!-- Name Label -->
            <div class="weapon-name-cell rollable" data-action="rollWeapon">
                <span class="weapon-name-label">{{item.name}}</span>
            </div>

            <!-- Damage -->
            <div class="weapon-damage-cell rollable" data-action="rollWeapon">
                {{#if item.system.damage}}{{item.system.damage}}{{else}}—{{/if}}
            </div>

            <!-- Controls -->
            <div class="skill-controls" style="justify-content: flex-end; display: flex; gap: 5px;">
                <button type="button" class="icon-button item-edit" data-action="editItem"
                    title="{{localize 'ABEA.Item.Edit'}}">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" class="icon-button item-delete" data-action="deleteItem"
                    title="{{localize 'ABEA.Item.Delete'}}">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
        {{/each}}
    </div>


</div>